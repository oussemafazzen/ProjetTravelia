<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.HebergementCardController" alignment="TOP_LEFT" spacing="0" styleClass="data-card">
    
    <!-- Accommodation Image -->
    <StackPane styleClass="card-banner" prefWidth="250" minHeight="200" style="-fx-background-color: #f1f5f9;">
        <ImageView fx:id="imgAccommodation" fitWidth="250" fitHeight="200" preserveRatio="false" style="-fx-background-radius: 20 0 0 20;"/>
        <VBox StackPane.alignment="TOP_LEFT" fx:id="badgeContainer">
            <StackPane styleClass="card-badge, badge-blue">
                <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                <Text fx:id="txtType" text="Hôtel" fill="white" style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
            </StackPane>
        </VBox>
    </StackPane>

    <!-- Content -->
    <VBox styleClass="card-content" HBox.hgrow="ALWAYS" spacing="15">
        <HBox alignment="TOP_LEFT" spacing="15">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Text fx:id="txtNom" text="Hôtel Grand Palace" styleClass="data-title"/>
                    <StackPane styleClass="badge-blue" prefHeight="25">
                        <padding><Insets left="10" right="10"/></padding>
                        <Text fx:id="txtTypeBadge" text="hôtel" styleClass="badge-text-blue" style="-fx-font-size: 11px;"/>
                    </StackPane>
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Text text="📍" style="-fx-fill: #94a3b8;"/>
                    <Text fx:id="txtLocation" text="123 Avenue des Champs, Paris, France" style="-fx-fill: #64748b; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>
            <VBox alignment="CENTER_RIGHT">
                <Text fx:id="txtTarif" text="180€" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-fill: #ff5e00;"/>
                <Text text="par nuit" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>

        <!-- Rating and Info -->
        <HBox spacing="20">
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Text text="⭐" style="-fx-fill: #ffb900;"/>
                <Text text="4.5" style="-fx-font-weight: bold; -fx-fill: #1e293b;"/>
                <Text text="/5" style="-fx-fill: #94a3b8;"/>
            </HBox>
        </HBox>

        <!-- Equipements -->
        <VBox spacing="10">
            <Text text="Équipements" style="-fx-font-weight: bold; -fx-fill: #1e293b; -fx-font-size: 13px;"/>
            <HBox fx:id="equipmentsBox" spacing="10"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Actions -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="Réserver" styleClass="card-btn, btn-outline" onAction="#handleReserve"/>
            <Button text="Voir détails" styleClass="card-btn, btn-outline" onAction="#handleDetails"/>
        </HBox>
    </VBox>
</HBox>
