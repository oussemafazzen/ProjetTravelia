<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="gui.HebergementController" spacing="20" styleClass="content-pane">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Gestion des Hébergements" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container">
            <Label text="🔍" style="-fx-font-size: 16px;"/>
            <TextField fx:id="tfSearch" promptText="Rechercher par nom..." prefWidth="250" styleClass="search-field"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10">
            <Button text="📊 Stats" onAction="#handleStats" styleClass="btn-info" style="-fx-background-color: #17a2b8; -fx-text-fill: white;"/>
            <Button text="📄 Export PDF" onAction="#handleExportPdf" styleClass="btn-secondary"/>
            <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="btn-primary"/>
            <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="btn-warning"/>
            <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
            <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-secondary"/>
        </HBox>
    </HBox>
    
    <!-- Table -->
    <TableView fx:id="tableHebergement" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
            <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="150"/>
            <TableColumn fx:id="colVille" text="Ville" prefWidth="100"/>
            <TableColumn fx:id="colPays" text="Pays" prefWidth="80"/>
            <TableColumn fx:id="colCapacite" text="Capacité" prefWidth="70"/>
            <TableColumn fx:id="colEquipements" text="Équipements" prefWidth="150"/>
            <TableColumn fx:id="colTarif" text="Tarif/Nuit" prefWidth="80"/>
        </columns>
    </TableView>
    
</VBox>
