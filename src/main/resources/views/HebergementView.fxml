<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="gui.HebergementController" spacing="16" styleClass="content-pane">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Top bar: Title + Search + Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="Gestion des Hébergements" styleClass="page-title"/>
            <Label text="Gérez votre catalogue d'hébergements" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-container">
            <Label text="🔍" style="-fx-font-size: 14px;"/>
            <TextField fx:id="tfSearch" promptText="Rechercher par nom ou pays..." prefWidth="250" styleClass="search-field"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="12">
            <Button text="📊 Stats"     onAction="#handleStats"     styleClass="btn-info"      style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 9; -fx-cursor: hand;"/>
            <Button text="📄 PDF"       onAction="#handleExportPdf" styleClass="btn-secondary" style="-fx-padding: 9 18; -fx-background-radius: 9; -fx-cursor: hand;"/>
            <Button text="➕ Ajouter un Hébergement"   onAction="#handleAdd"       styleClass="btn-primary"   style="-fx-padding: 9 22; -fx-background-radius: 9; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="🔄"           onAction="#handleRefresh"   styleClass="btn-secondary" style="-fx-padding: 9 12; -fx-background-radius: 9; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Stats Bar -->
    <HBox spacing="16" styleClass="table-stats-bar" alignment="CENTER_LEFT">
        <!-- Total card -->
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="🏨" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="TOTAL" styleClass="stat-label"/>
                <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Trier par:" style="-fx-text-fill: #6c7293; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Button text="🏷️ Type"  onAction="#handleSortByType"  styleClass="btn-sort"/>
            <Button text="🏙️ Ville" onAction="#handleSortByVille" styleClass="btn-sort"/>
        </HBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableHebergement" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNom"         text="  Nom"        prefWidth="160"/>
            <TableColumn fx:id="colType"        text="  Type"       prefWidth="110"/>
            <TableColumn fx:id="colAdresse"     text="  Adresse"    prefWidth="160"/>
            <TableColumn fx:id="colVille"       text="  Ville"      prefWidth="110"/>
            <TableColumn fx:id="colPays"        text="  Pays"       prefWidth="90"/>
            <TableColumn fx:id="colCapacite"    text="  Capacité"   prefWidth="80"/>
            <TableColumn fx:id="colEquipements" text="  Équipements" prefWidth="160"/>
            <TableColumn fx:id="colTarif"       text="  Tarif/Nuit" prefWidth="110"/>
            <TableColumn fx:id="colActions"     text="  Actions"    prefWidth="120" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="🏨  Aucun hébergement trouvé" style="-fx-font-size: 16px; -fx-text-fill: #6c7293; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

</VBox>
