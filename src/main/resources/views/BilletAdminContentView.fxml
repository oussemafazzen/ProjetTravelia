<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.BilletAdminController" spacing="16" styleClass="content-pane">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Top bar: Title + Search + Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="Gestion des Billets" styleClass="page-title"/>
            <Label text="Gérez l'inventaire des billets" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-container">
                <Label text="🔍" style="-fx-font-size: 14px;"/>
                <TextField fx:id="tfSearch" promptText="Rechercher par numéro du billet..." prefWidth="250" styleClass="search-field"/>
            </HBox>
            <Button text="🔄" onAction="#handleRefresh" styleClass="btn-secondary" style="-fx-padding: 9 12; -fx-background-radius: 9; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Stats Bar (Simulated style from Hebergement) -->
    <HBox spacing="16" styleClass="table-stats-bar" alignment="CENTER_LEFT">
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="🎫" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="TOTAL BILLETS" styleClass="stat-label"/>
                <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="sort-group">
            <Label text="Trier par:" style="-fx-text-fill: #6c7293; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Button text="📅 Départ" onAction="#handleSortByDate" styleClass="btn-sort"/>
            <Button text="🔄 Statut" onAction="#handleSortByStatut" styleClass="btn-sort"/>
        </HBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableBillet" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId"          text="  ID"          prefWidth="60"/>
            <TableColumn fx:id="colNumero"      text="  Numéro"      prefWidth="140"/>
            <TableColumn fx:id="colTransport"   text="  Transport"   prefWidth="110"/>
            <TableColumn fx:id="colDepart"      text="  Départ"       prefWidth="160"/>
            <TableColumn fx:id="colArrivee"     text="  Arrivée"      prefWidth="160"/>
            <TableColumn fx:id="colPrix"        text="  Prix"         prefWidth="100"/>
            <TableColumn fx:id="colStatut"      text="  Statut"       prefWidth="110"/>
            <TableColumn fx:id="colReservation" text="  Réserv. ID"   prefWidth="90"/>
            <TableColumn fx:id="colActions"     text="  Actions"      prefWidth="120" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="🎫 Aucun billet trouvé" style="-fx-font-size: 16px; -fx-text-fill: #6c7293; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

</VBox>
