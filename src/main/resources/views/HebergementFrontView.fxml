<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="30" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HebergementFrontController">
    <VBox spacing="40" style="-fx-padding: 40;">
        <!-- Header Section -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER" maxHeight="60" maxWidth="60" minHeight="60" minWidth="60" prefHeight="60" prefWidth="60" style="-fx-background-color: linear-gradient(to bottom right, #ff5e00, #ff922b); -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(255, 94, 0, 0.3), 15, 0, 0, 5);" styleClass="icon-box">
                <Text fill="WHITE" style="-fx-font-size: 32px;" text="🏠" />
            </HBox>
            <VBox minWidth="220.0" spacing="5" HBox.hgrow="ALWAYS">
                <Text style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-fill: #1e293b;" text="Hébergement &amp; Logement" />
                <Text style="-fx-font-size: 16px; -fx-fill: #64748b;" text="Gérez tous vos hébergements et réservations" />
            </VBox>
        </HBox>

        <!-- Search Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="front-search-container">
            <Button onAction="#handleOpenMap" style="-fx-font-size: 22px; -fx-background-color: linear-gradient(to bottom right, #3b82f6, #06b6d4); -fx-text-fill: white; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.2), 10, 0, 0, 3);" text="🗺️" />
            <Button onAction="#handleOpenCountrySelector" style="-fx-font-size: 22px; -fx-background-color: linear-gradient(to bottom right, #f59e0b, #ef4444); -fx-text-fill: white; -fx-background-radius: 12; -fx-min-width: 50; -fx-min-height: 50; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(239, 68, 68, 0.2), 10, 0, 0, 3);" text="🌍" />
            <TextField fx:id="tfSearchNom" prefHeight="50.0" prefWidth="361.0" promptText="Rechercher par nom (ex: Hotel Royal...)" style="-fx-background-radius: 12; -fx-padding: 0 20;" styleClass="front-search-input" HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Stats Section -->
        <HBox spacing="30">
            <VBox spacing="15" styleClass="stat-card-container" HBox.hgrow="ALWAYS">
                <Text styleClass="stat-label" text="Total Hébergements" />
                <Text fx:id="txtTotalHebergements" style="-fx-fill: #ff4d4d;" styleClass="stat-value" text="3" />
            </VBox>
            <VBox spacing="15" styleClass="stat-card-container" HBox.hgrow="ALWAYS">
                <Text styleClass="stat-label" text="Tarif Moyen/Nuit" />
                <Text fx:id="txtMoyenTarif" style="-fx-fill: #ffb900;" styleClass="stat-value" text="158 DT" />
            </VBox>
        </HBox>

        <!-- Cards List Container -->
        <VBox fx:id="cardsContainer" spacing="30" />

        <!-- Pagination Section -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0;">
            <Button fx:id="btnPrev" onAction="#handlePreviousPage" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" text="← Précédent" />
            
            <HBox alignment="CENTER" spacing="5">
                <Text style="-fx-fill: #94a3b8; -fx-font-size: 14px;" text="Page" />
                <Text fx:id="txtCurrentPage" style="-fx-fill: #ff5e00; -fx-font-weight: 900; -fx-font-size: 16px;" text="1" />
                <Text style="-fx-fill: #94a3b8; -fx-font-size: 14px;" text="sur" />
                <Text fx:id="txtTotalPages" style="-fx-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 14px;" text="5" />
            </HBox>

            <Button fx:id="btnNext" onAction="#handleNextPage" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" text="Suivant →" />
        </HBox>
    </VBox>
</VBox>
