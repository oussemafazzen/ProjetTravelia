<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ReservationHebergementController" spacing="16" styleClass="content-pane">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Top bar: Title + Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="Réservations d'Hébergement" styleClass="page-title"/>
            <Label text="Suivi et gestion de toutes les réservations" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8">
            <Button text="📊 Stats"     onAction="#handleStats"     styleClass="btn-info"      style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="📄 PDF"       onAction="#handleExportPdf" styleClass="btn-secondary" style="-fx-padding: 9 16; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="➕ Ajouter"   onAction="#handleAdd"       styleClass="btn-primary"   style="-fx-padding: 9 16; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="✏️ Modifier"  onAction="#handleUpdate"    styleClass="btn-warning"   style="-fx-padding: 9 16; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="🗑️ Supprimer" onAction="#handleDelete"    styleClass="btn-danger"    style="-fx-padding: 9 16; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="🔄"           onAction="#handleRefresh"   styleClass="btn-secondary" style="-fx-padding: 9 12; -fx-background-radius: 7; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Stats Bar -->
    <HBox spacing="16" styleClass="table-stats-bar" alignment="CENTER_LEFT">
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="📋" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="TOTAL" styleClass="stat-label"/>
                <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="✅" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="CONFIRMÉES" styleClass="stat-label"/>
                <Label fx:id="lblConfirmed" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="⏳" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="EN ATTENTE" styleClass="stat-label"/>
                <Label fx:id="lblPending" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Mise à jour en temps réel" style="-fx-text-fill: #6c7293; -fx-font-size: 11px; -fx-font-style: italic;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId"             text="  #"            prefWidth="50"/>
            <TableColumn fx:id="colDateDebut"      text="  Date Début"   prefWidth="130"/>
            <TableColumn fx:id="colDateFin"        text="  Date Fin"     prefWidth="130"/>
            <TableColumn fx:id="colNbPersonnes"    text="  Personnes"    prefWidth="100"/>
            <TableColumn fx:id="colStatut"         text="  Statut"       prefWidth="130"/>
            <TableColumn fx:id="colIdClient"       text="  ID Client"    prefWidth="90"/>
            <TableColumn fx:id="colIdHebergement"  text="  Hébergement"  prefWidth="160"/>
        </columns>
        <placeholder>
            <Label text="📋  Aucune réservation trouvée" style="-fx-font-size: 16px; -fx-text-fill: #6c7293; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

</VBox>
