<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ReservationHebergementController" spacing="20" styleClass="content-pane">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Réservations d'Hébergement" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10">
            <Button text="📊 Stats" onAction="#handleStats" styleClass="btn-info" style="-fx-background-color: #17a2b8; -fx-text-fill: white;"/>
            <Button text="📄 Export PDF" onAction="#handleExportPdf" styleClass="btn-secondary"/>
            <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="btn-primary"/>
            <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="btn-warning"/>
            <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="btn-danger"/>
            <Button text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-secondary"/>
        </HBox>
    </HBox>
    
    <!-- Table -->
    <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colDateDebut" text="Date Début" prefWidth="120"/>
            <TableColumn fx:id="colDateFin" text="Date Fin" prefWidth="120"/>
            <TableColumn fx:id="colNbPersonnes" text="Personnes" prefWidth="80"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
            <TableColumn fx:id="colIdClient" text="ID Client" prefWidth="80"/>
            <TableColumn fx:id="colIdHebergement" text="ID Héberg." prefWidth="80"/>
        </columns>
    </TableView>
    
</VBox>
