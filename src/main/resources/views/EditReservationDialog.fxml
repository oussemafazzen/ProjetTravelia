<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.EditReservationDialogController"
      spacing="14" styleClass="dialog-root" prefWidth="420">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <Label text="Modifier réservation" styleClass="dialog-title"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Date" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDate" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Paiement" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPaiement" prefWidth="220" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Statut" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatut" prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblError" text="" styleClass="error-text" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onCancel" styleClass="btn-outline"/>
        <Button text="Enregistrer" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>

</VBox>