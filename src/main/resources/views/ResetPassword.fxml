<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../css/client-style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ResetPasswordController">
   <children>
      <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="card">
               <children>
                  <Label styleClass="title-label" text="Nouveau Mot de Passe" textAlignment="CENTER" wrapText="true" />
                  <Label fx:id="lblUserEmail" style="-fx-font-style: italic;" text="Email : user@example.com" />
                  <PasswordField fx:id="newPasswordF" promptText="Réinitialiser votre mot de passe" styleClass="password-field" />
                  <PasswordField fx:id="confirmPasswordF" promptText="Confirmer votre mot de passe" styleClass="password-field" />
                  <Button fx:id="btnReset" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleResetPassword" styleClass="button" text="Réinitialiser" />
                  <Label fx:id="lblMessage" styleClass="error-label" />
                  <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Annuler" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
