<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.NewReservationDialogController"
      styleClass="dialog-root" prefWidth="440">

    <!-- Header Section -->
    <HBox styleClass="dialog-header" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>
        <Label text="✨" styleClass="dialog-header-icon"/>
        <Label text="Nouvelle réservation" styleClass="dialog-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Content Section -->
    <VBox spacing="20" styleClass="dialog-content">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        
        <Label text="Remplis les informations ci-dessous." styleClass="dialog-subtitle"/>

        <VBox spacing="18">
            <!-- Date Field -->
            <VBox spacing="8">
                <Label text="Date" styleClass="form-label"/>
                <DatePicker fx:id="dpDate" prefWidth="400" styleClass="form-control" promptText="Choisir une date"/>
            </VBox>

            <!-- Payment Field -->
            <VBox spacing="8">
                <Label text="Paiement" styleClass="form-label"/>
                <ComboBox fx:id="cbPaiement" prefWidth="400" styleClass="form-control" promptText="Sélectionner le mode"/>
            </VBox>
        </VBox>

        <Label fx:id="lblError" text="" styleClass="form-error" managed="false" visible="false"/>

        <!-- Action Buttons -->
        <HBox spacing="14" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
            <Button text="Annuler" onAction="#onCancel" styleClass="btn-outline" 
                    style="-fx-padding: 10 24; -fx-background-radius: 12;"/>
            <Button text="Enregistrer" onAction="#onSave" styleClass="gradient-btn" 
                    style="-fx-padding: 10 24; -fx-background-radius: 12;"/>
        </HBox>
    </VBox>

</VBox>