<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="500.0" prefWidth="600.0" 
      style="-fx-background-color: white; -fx-padding: 30;" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controllers.CameraController">
    
    <Label text="Connexion par Reconnaissance Faciale" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #2c3e50;" />

    <StackPane fx:id="container" prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-background-radius: 10;">
        <ImageView fx:id="cameraView" fitHeight="300.0" fitWidth="400.0" preserveRatio="true" />
        
        <!-- Permission Overlay -->
        <VBox fx:id="permissionBox" alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10;">
             <ImageView fitHeight="48" fitWidth="48">
                <Image url="@../images/camera-icon.png" />
             </ImageView>
             <Label text="Autoriser l'accès à la caméra ?" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
             <HBox alignment="CENTER" spacing="10">
                 <Button fx:id="btnAllow" text="Autoriser cette fois" onAction="#handleAllow" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 20;" />
                 <Button fx:id="btnDeny" text="Refuser" onAction="#handleDeny" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 20;" />
             </HBox>
        </VBox>
    </StackPane>

    <Label fx:id="lblStatus" text="En attente d'autorisation..." style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
    
    <Button fx:id="btnCancel" text="Annuler" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true;" />

</VBox>
