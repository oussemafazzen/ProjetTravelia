<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.ActiviteController" spacing="16" styleClass="content-pane">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Top bar: Title + Search + Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="Gestion des Activités" styleClass="page-title"/>
            <Label text="Gérez votre catalogue d'activités touristiques" style="-fx-text-fill: #6c757d; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-container">
            <Label text="🔍" style="-fx-font-size: 14px;"/>
            <TextField fx:id="tfSearch" promptText="Rechercher par nom ou lieu..." prefWidth="250" styleClass="search-field"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="12">
            <Button text="📄 PDF"       onAction="#handleExportPdf" styleClass="btn-secondary" style="-fx-padding: 9 18; -fx-background-radius: 9; -fx-cursor: hand;"/>
            <Button text="➕ Ajouter une Activité"   onAction="#handleAdd"       styleClass="btn-primary"   style="-fx-padding: 9 22; -fx-background-radius: 9; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Button text="🔄"           onAction="#handleRefresh"   styleClass="btn-secondary" style="-fx-padding: 9 12; -fx-background-radius: 9; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- Stats Bar -->
    <HBox spacing="16" styleClass="table-stats-bar" alignment="CENTER_LEFT">
        <!-- Total card -->
        <HBox styleClass="stat-card" alignment="CENTER_LEFT" spacing="4">
            <Label text="🎯" styleClass="stat-icon"/>
            <VBox spacing="1">
                <Label text="TOTAL" styleClass="stat-label"/>
                <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Trier par:" style="-fx-text-fill: #6c7293; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <Button text="📂 Catégorie"  onAction="#handleSortByCategorie"  styleClass="btn-sort"/>
            <Button text="📍 Lieu" onAction="#handleSortByLieu" styleClass="btn-sort"/>
        </HBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tableActivite" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNom"         text="  Nom"          prefWidth="150"/>
            <TableColumn fx:id="colDescription" text="  Description"  prefWidth="180"/>
            <TableColumn fx:id="colLieu"        text="  Lieu"         prefWidth="120"/>
            <TableColumn fx:id="colDuree"       text="  Durée (min)"  prefWidth="90"/>
            <TableColumn fx:id="colPrix"        text="  Prix"         prefWidth="100"/>
            <TableColumn fx:id="colCapacite"    text="  Capacité"     prefWidth="80"/>
            <TableColumn fx:id="colCategorie"   text="  Catégorie"    prefWidth="110"/>
            <TableColumn fx:id="colActions"     text="  Actions"      prefWidth="120" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="🎯  Aucune activité trouvée" style="-fx-font-size: 16px; -fx-text-fill: #6c7293; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

</VBox>
