<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ReservationStatsController" 
      spacing="20" alignment="CENTER" styleClass="modal-pane" prefWidth="600" prefHeight="500">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Statistiques Saisonnières des Réservations" styleClass="modal-title"/>
    
    <PieChart fx:id="pieChartSeasons" VBox.vgrow="ALWAYS" />
    
    <Label fx:id="lblStatus" text="" style="-fx-text-fill: #adb5bd; -fx-font-style: italic;"/>
</VBox>
