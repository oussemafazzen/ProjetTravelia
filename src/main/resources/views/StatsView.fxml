<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StatsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <children>
            <VBox spacing="2">
                <Label text="Tableau de Bord Analytique" styleClass="page-title"/>
                <Label text="Analyse consolidée : Clients, Hébergements et Réservations" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Actualiser Tout" onAction="#onRefresh" styleClass="btn-primary"/>
        </children>
    </HBox>

    <Separator styleClass="content-separator" />

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
        <content>
            <VBox spacing="30.0">
                
                <!-- KPI Section -->
                <VBox spacing="10">
                    <Label text="Indicateurs de Performance" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="15.0">
                        <children>
                            <VBox prefWidth="175.0" styleClass="stat-card">
                                <children>
                                    <Label styleClass="stat-label" text="Total Clients" />
                                    <Label fx:id="lblTotalClients" styleClass="stat-value" text="0" />
                                </children>
                            </VBox>
                            <VBox prefWidth="175.0" styleClass="stat-card">
                                <children>
                                    <Label styleClass="stat-label" text="Hébergements" />
                                    <Label fx:id="lblTotalHebergements" styleClass="stat-value" text="0" />
                                </children>
                            </VBox>
                            <VBox prefWidth="175.0" styleClass="stat-card">
                                <children>
                                    <Label styleClass="stat-label" text="Rés. Vols" />
                                    <Label fx:id="lblTotalReservations" styleClass="stat-value" text="0" />
                                </children>
                            </VBox>
                            <VBox prefWidth="220.0" styleClass="stat-card">
                                <children>
                                    <Label styleClass="stat-label" text="Chiffre d'Affaire (Vols)" />
                                    <Label fx:id="lblMontantTotal" styleClass="stat-value" text="0 DT" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </VBox>

                <Separator />

                <!-- Section: Clients -->
                <VBox spacing="10">
                    <Label text="Analyse des Clients" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="20.0">
                        <children>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Répartition de la Fidélité" />
                                    <PieChart fx:id="pieLoyalty" prefHeight="350.0" />
                                </children>
                            </VBox>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Répartition par Nationalité" />
                                    <PieChart fx:id="pieNationality" prefHeight="350.0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </VBox>

                <Separator />

                <!-- Section: Hébergements -->
                <VBox spacing="10">
                    <Label text="Analyse des Hébergements" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="20.0">
                        <children>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Types (Villas/Hôtels/Auberges)" />
                                    <PieChart fx:id="pieHebType" prefHeight="350.0" />
                                </children>
                            </VBox>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Hôtels vs Auberges par Pays" />
                                    <BarChart fx:id="barGroupedHebPays" prefHeight="350.0">
                                        <xAxis><CategoryAxis side="BOTTOM" label="Pays" /></xAxis>
                                        <yAxis><NumberAxis side="LEFT" label="Nombre" /></yAxis>
                                    </BarChart>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </VBox>

                <Separator />

                <!-- Section: Réservations & Billets (Vols) -->
                <VBox spacing="10">
                    <Label text="Analyse des Vols &amp; Billets" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <HBox spacing="20.0">
                        <children>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Statut Réservations Vols" />
                                    <PieChart fx:id="pieStatut" prefHeight="350.0" />
                                </children>
                            </VBox>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Top Destinations Vol" />
                                    <BarChart fx:id="barPays" prefHeight="350.0">
                                        <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                        <yAxis><NumberAxis side="LEFT" /></yAxis>
                                    </BarChart>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                    <VBox alignment="CENTER" spacing="10.0" styleClass="card">
                        <children>
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Évolution Mensuelle (Vols)" />
                            <LineChart fx:id="lineMois" prefHeight="300.0">
                                <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                <yAxis><NumberAxis side="LEFT" /></yAxis>
                            </LineChart>
                        </children>
                    </VBox>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>
