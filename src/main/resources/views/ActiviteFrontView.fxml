<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ActiviteFrontController"
           alignment="TOP_CENTER" spacing="25.0" style="-fx-background-color: #f4f7fa;">

    <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

    <!-- Page Header -->
    <VBox alignment="CENTER" spacing="6.0">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <StackPane prefHeight="48" prefWidth="48" style="-fx-background-color: #ef4444; -fx-background-radius: 14;">
                <Label style="-fx-font-size: 22px; -fx-text-fill: white;" text="📍"/>
            </StackPane>
            <VBox spacing="2">
                <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="Activités Touristiques"/>
                <Label style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;" text="Gérez toutes vos activités et inscriptions"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Stats Card - Only Total Activités -->
    <HBox spacing="20" maxWidth="1100">
        <VBox prefWidth="280" spacing="4" styleClass="white-stat-card">
            <Label styleClass="white-stat-title" text="Total Activités"/>
            <Label fx:id="lblTotalActivites" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #0156ff;" text="0"/>
        </VBox>
    </HBox>

    <!-- AI Recommendations -->
    <VBox fx:id="boxRecommendations" maxWidth="1100" spacing="10"/>

    <!-- Search &amp; Filter Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" maxWidth="1100">
        <HBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-padding: 8 16;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;" text="🔍"/>
            <TextField fx:id="tfSearch" promptText="Rechercher une activité..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ComboBox fx:id="cbFilterCategorie" promptText="Toutes les catégories" prefWidth="200"
                  style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 6 12;"/>
    </HBox>

    <!-- Activity Cards Grid -->
    <VBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardsContainer" hgap="24" vgap="24" alignment="CENTER" maxWidth="1000" prefWrapLength="1000">
            <padding><Insets top="5" right="5" bottom="20" left="5"/></padding>
        </FlowPane>
    </VBox>

    <!-- Pagination Section -->
    <HBox fx:id="paginationBox" alignment="CENTER" spacing="20" style="-fx-padding: 10 0 20 0;">
        <Button fx:id="btnPrev" onAction="#handlePreviousPage" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" text="← Précédent" />
        
        <HBox alignment="CENTER" spacing="5">
            <Text style="-fx-fill: #94a3b8; -fx-font-size: 14px;" text="Page" />
            <Text fx:id="txtCurrentPage" style="-fx-fill: #0156ff; -fx-font-weight: 900; -fx-font-size: 16px;" text="1" />
            <Text style="-fx-fill: #94a3b8; -fx-font-size: 14px;" text="sur" />
            <Text fx:id="txtTotalPages" style="-fx-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 14px;" text="1" />
        </HBox>

        <Button fx:id="btnNext" onAction="#handleNextPage" style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;" text="Suivant →" />
    </HBox>

</VBox>
