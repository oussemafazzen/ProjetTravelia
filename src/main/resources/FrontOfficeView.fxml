<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="800" prefWidth="1200" styleClass="frontoffice-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.FrontOfficeController">

    <stylesheets>
        <URL value="@/frontoffice-styles.css" />
    </stylesheets>

    <!-- TOP NAVIGATION BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-navbar">
            <!-- Brand -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="40.0" prefWidth="30.0" style="-fx-background-color: linear-gradient(to right, #0156ff, #00d1ff); -fx-background-radius: 10;; -fx-padding: 8; -fx-background-radius: 10;">
               <children>
                  <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="#f9f7f7" rotate="45.0" scaleX="1.2" scaleY="1.5" />
               </children>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Text style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-fill: linear-gradient(to right, #0156ff, #00d1ff); -fx-background-radius: 10;;" text="Travelia" />
                    <Text style="-fx-font-size: 10px; -fx-fill: #64748b;" text="by DevTravel" />
                </VBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />

            <!-- Nav Links -->
            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="homeBtn" onAction="#handleHome" style="-fx-background-radius: 10;" styleClass="nav-link, active" text="🏠 Accueil" />
                <Button fx:id="clientsBtn" onAction="#handleClients" style="-fx-background-radius: 10;" styleClass="nav-link" text="👥 Clients" />
                <Button fx:id="reservationsBtn" onAction="#handleReservations" style="-fx-background-radius: 10;" styleClass="nav-link" text="📅 Réservations" />
                <Button fx:id="hebergementBtn" onAction="#handleHebergement" style="-fx-background-radius: 10;" styleClass="nav-link" text="🏠 Hébergement" />
                <Button fx:id="activitesBtn" onAction="#handleActivites" style="-fx-background-radius: 10;" styleClass="nav-link" text="📍 Activités" />
                <Button fx:id="avisBtn" onAction="#handleAvis" style="-fx-background-radius: 10;" styleClass="nav-link" text="⭐ Avis" />
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />

            <!-- User Actions -->
            <HBox alignment="CENTER" spacing="15">
                <StackPane style="-fx-background-color: #f1f5f9; -fx-padding: 8; -fx-background-radius: 20;" />
            </HBox>
        </HBox>
    </top>

    <!-- MAIN CONTENT AREA -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="scroll-pane">
            <content>
                <VBox fx:id="contentArea" spacing="0" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>
