<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.NewReservationDialogController"
      spacing="14" styleClass="dialog-root">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="➕ Nouvelle réservation" styleClass="dialog-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label text="Remplis les informations ci-dessous." styleClass="muted"/>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Date" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <DatePicker fx:id="dpDate" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Paiement" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <ComboBox fx:id="cbPaiement" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Statut" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="dialog-label"/>
        <ComboBox fx:id="cbStatut" prefWidth="260" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblError" text="" styleClass="dialog-error" managed="false" visible="false"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Annuler" onAction="#onCancel" styleClass="btn-outline"/>
        <Button text="Enregistrer" onAction="#onSave" styleClass="gradient-btn"/>
    </HBox>

</VBox>