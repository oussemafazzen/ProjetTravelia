<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ResetPasswordController">
   <children>
      <VBox alignment="CENTER" fillWidth="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" prefWidth="400.0" spacing="20.0" styleClass="card">
               <children>
                  <Label styleClass="title-label-small" text="Réinitialiser le mot de passe" />
                  <Label fx:id="lblUserEmail" style="-fx-font-size: 13; -fx-text-fill: #666;" text="Email : " />
                   <TextField fx:id="codeF" promptText="Code de vérification (6 chiffres)" styleClass="text-field" />
                   <Button fx:id="btnVerify" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleVerifyCode" styleClass="button" text="Vérifier le code" />
                   
                   <VBox fx:id="passwordBox" spacing="15.0" visible="false" managed="false" alignment="CENTER">
                       <children>
                           <PasswordField fx:id="newPasswordF" promptText="Nouveau mot de passe" styleClass="password-field" />
                           <PasswordField fx:id="confirmPasswordF" promptText="Confirmer le mot de passe" styleClass="password-field" />
                           <Button fx:id="btnReset" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleResetPassword" styleClass="button" text="Changer le mot de passe" />
                       </children>
                   </VBox>
                  <Label fx:id="lblMessage" styleClass="error-label" textFill="#e40e0e" />
                  <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Retour à la connexion" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
