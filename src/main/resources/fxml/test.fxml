<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.TestController"
            styleClass="app-root">

    <top>
        <VBox>
            <!-- ✅ moins de vide en haut -->
            <padding>
                <Insets top="14" right="30" bottom="0" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" styleClass="navbar">
                <padding>
                    <Insets top="10" right="22" bottom="10" left="22"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="logo-box">
                        <Label text="✈" styleClass="logo-icon"/>
                    </StackPane>

                    <VBox spacing="0">
                        <Label text="Travelia" styleClass="brand-title"/>
                        <Label text="by DevTravel" styleClass="brand-subtitle"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="16" alignment="CENTER" styleClass="nav-menu">
                    <Button fx:id="btnHome" onAction="#goHome" styleClass="nav-item">
                        <graphic><Label text="⌂" styleClass="nav-icon"/></graphic>
                        <text>Accueil</text>
                    </Button>

                    <Button fx:id="btnClients" onAction="#goClients" styleClass="nav-item">
                        <graphic><Label text="👤" styleClass="nav-icon"/></graphic>
                        <text>Clients</text>
                    </Button>

                    <Button fx:id="btnReservations" onAction="#goReservations" styleClass="nav-item">
                        <graphic><Label text="📅" styleClass="nav-icon"/></graphic>
                        <text>Réservations</text>
                    </Button>

                    <Button fx:id="btnHebergement" onAction="#goHebergement" styleClass="nav-item">
                        <graphic><Label text="⌂" styleClass="nav-icon"/></graphic>
                        <text>Hébergement</text>
                    </Button>

                    <Button fx:id="btnActivites" onAction="#goActivites" styleClass="nav-item">
                        <graphic><Label text="📍" styleClass="nav-icon"/></graphic>
                        <text>Activités</text>
                    </Button>

                    <Button fx:id="btnAvis" onAction="#goAvis" styleClass="nav-item">
                        <graphic><Label text="★" styleClass="nav-icon"/></graphic>
                        <text>Avis</text>
                    </Button>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    pannable="true"
                    hbarPolicy="NEVER"
                    styleClass="page-scroll">

            <content>
                <!-- ✅ spacing réduit + padding réduit (remplit mieux l’écran) -->
                <VBox alignment="TOP_CENTER" spacing="10" styleClass="page">
                    <padding>
                        <Insets top="16" right="28" bottom="16" left="28"/>
                    </padding>

                    <!-- ✅ HERO plus rempli -->
                    <StackPane styleClass="hero-card" maxWidth="1180">
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="38" right="55" bottom="38" left="55"/>
                            </padding>

                            <VBox spacing="14"
                                  alignment="CENTER_LEFT"
                                  HBox.hgrow="ALWAYS"
                                  minWidth="0">

                                <Label text="Bienvenue sur Travelia"
                                       styleClass="hero-title"
                                       wrapText="true"
                                       maxWidth="460"/>

                                <Label text="Votre plateforme complète de gestion de voyages &amp; loisirs"
                                       styleClass="hero-subtitle"
                                       wrapText="true"
                                       maxWidth="460"/>

                                <Label text="Gérez facilement vos clients, réservations, hébergements, activités et avis."
                                       styleClass="hero-text"
                                       wrapText="true"
                                       maxWidth="460"/>

                                <Button text="Commencer  →" styleClass="hero-btn"/>
                            </VBox>

                            <StackPane styleClass="hero-image-wrap"
                                       alignment="CENTER"
                                       prefWidth="560"
                                       minWidth="560"
                                       maxWidth="560"
                                       prefHeight="300"
                                       minHeight="300"
                                       maxHeight="300">

                                <ImageView fx:id="heroImage"
                                           fitWidth="560"
                                           fitHeight="300"
                                           preserveRatio="false"
                                           smooth="true"
                                           styleClass="hero-image"/>
                            </StackPane>
                        </HBox>
                    </StackPane>

                    <!-- ✅ supprimé le Region vide -->

                    <VBox alignment="CENTER" spacing="4" styleClass="modules-header">
                        <Label text="Modules Disponibles" styleClass="section-title"/>
                        <Label text="Explorez toutes les fonctionnalités de Travelia" styleClass="section-subtitle"/>
                    </VBox>

                    <GridPane hgap="22" vgap="22"
                              alignment="CENTER"
                              maxWidth="1120"
                              styleClass="modules-grid">

                        <columnConstraints>
                            <ColumnConstraints minWidth="320" prefWidth="360" maxWidth="380"/>
                            <ColumnConstraints minWidth="320" prefWidth="360" maxWidth="380"/>
                            <ColumnConstraints minWidth="320" prefWidth="360" maxWidth="380"/>
                        </columnConstraints>

                        <VBox GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="360" styleClass="module-card">
                            <StackPane styleClass="module-icon, module-blue">
                                <Label text="👥" styleClass="module-icon-text"/>
                            </StackPane>
                            <Label text="Clients &amp; Préférences" styleClass="module-title"/>
                            <Label text="Gérez vos clients et leurs préférences de voyage personnalisées"
                                   wrapText="true" styleClass="module-desc"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Accéder au module  →" styleClass="module-link" onAction="#goClients"/>
                        </VBox>

                        <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="360"
                              styleClass="module-card, module-card-active">
                            <StackPane styleClass="module-icon, module-pink">
                                <Label text="📅" styleClass="module-icon-text"/>
                            </StackPane>
                            <Label text="Réservations &amp; Billets" styleClass="module-title"/>
                            <Label text="Suivez toutes les réservations et gérez les billets de transport"
                                   wrapText="true" styleClass="module-desc"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Accéder au module  →" styleClass="module-link" onAction="#goReservations"/>
                        </VBox>

                        <VBox GridPane.rowIndex="0" GridPane.columnIndex="2" prefWidth="360" styleClass="module-card">
                            <StackPane styleClass="module-icon, module-orange">
                                <Label text="🏠" styleClass="module-icon-text"/>
                            </StackPane>
                            <Label text="Hébergement &amp; Logement" styleClass="module-title"/>
                            <Label text="Administrez les hébergements et les réservations de chambres"
                                   wrapText="true" styleClass="module-desc"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Accéder au module  →" styleClass="module-link" onAction="#goHebergement"/>
                        </VBox>

                        <VBox GridPane.rowIndex="1" GridPane.columnIndex="0" prefWidth="360" styleClass="module-card">
                            <StackPane styleClass="module-icon, module-green">
                                <Label text="📍" styleClass="module-icon-text"/>
                            </StackPane>
                            <Label text="Activités Touristiques" styleClass="module-title"/>
                            <Label text="Organisez des activités et inscriptions pour vos clients"
                                   wrapText="true" styleClass="module-desc"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Accéder au module  →" styleClass="module-link" onAction="#goActivites"/>
                        </VBox>

                        <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="360" styleClass="module-card">
                            <StackPane styleClass="module-icon, module-yellow">
                                <Label text="★" styleClass="module-icon-text"/>
                            </StackPane>
                            <Label text="Avis &amp; Recommandations" styleClass="module-title"/>
                            <Label text="Consultez les avis clients et leurs recommandations"
                                   wrapText="true" styleClass="module-desc"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Accéder au module  →" styleClass="module-link" onAction="#goAvis"/>
                        </VBox>

                    </GridPane>

                    <Region prefHeight="8"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>