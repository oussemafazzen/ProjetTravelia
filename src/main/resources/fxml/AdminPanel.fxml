<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" minHeight="-Infinity" minWidth="-Infinity" styleClass="main-pane" stylesheets="@../css/admin-theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminPanelController">
   <children>
      <BorderPane styleClass="main-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" styleClass="admin-header" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="btnSidebarToggle" mnemonicParsing="false" onAction="#toggleSidebar" styleClass="hamburger-btn" text="☰" />
                  <Label styleClass="logo-header" text="Travelia Admin">
                     <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
         </top>
         <left>
            <VBox fx:id="sidebarVBox" prefHeight="600.0" prefWidth="250.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Region prefHeight="20.0" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showUserManagement" styleClass="nav-button" text="Gestion Utilisateurs" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAdminManagement" styleClass="nav-button" text="Gestion Administrateurs" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showReservations" styleClass="nav-button" text="Gestion Réservation &amp; billets" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showAccommodations" styleClass="nav-button" text="Gestion Hébergements &amp; Logements" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showActivities" styleClass="nav-button" text="Gestion d'Activités Touristiques" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showReviews" styleClass="nav-button" text="Gestion Avis &amp; Recommendations" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#showStatistics" styleClass="nav-button" text="Statistiques" />
                  <Region VBox.vgrow="ALWAYS" />
                  <Button fx:id="btnThemeToggle" maxWidth="Infinity" mnemonicParsing="false" onAction="#toggleTheme" styleClass="nav-button" text="☀️ Mode Clair" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-button" text="Déconnexion" />
               </children>
               <padding>
                  <Insets bottom="20.0" top="20.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <ScrollPane fx:id="mainScrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;">
               <content>
                  <StackPane fx:id="mainStackPane">
               <children>
                  <!-- User Management View -->
                  <VBox fx:id="userManagementView" spacing="20.0" styleClass="content-pane">
                     <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label styleClass="page-title" text="Gestion des Clients" />
                              <Region HBox.hgrow="ALWAYS" />
                              <TextField fx:id="txtSearch" prefWidth="300.0" promptText="Rechercher par nom ou email..." styleClass="text-field" />
                              <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="btn-primary" text="Rechercher" />
                           </children>
                        </HBox>
                        
                        <!-- Key Stats Summary in User Management -->
                        <HBox spacing="15.0" styleClass="table-stats-bar">
                           <children>
                              <VBox prefWidth="200.0" styleClass="stat-card">
                                 <children>
                                    <Label styleClass="stat-label" text="Total Utilisateurs" />
                                    <Label fx:id="lblTotalUsers" styleClass="stat-value" text="0" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="200.0" styleClass="stat-card">
                                 <children>
                                    <Label styleClass="stat-label" text="Utilisateurs Bloqués" />
                                    <Label fx:id="lblBlockedUsers" styleClass="stat-value" text="0" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="250.0" styleClass="stat-card">
                                 <children>
                                    <Label styleClass="stat-label" text="Revenu Total Simulé" />
                                    <Label fx:id="lblTotalRevenue" styleClass="stat-value" text="0 €" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleSortByPoints" styleClass="btn-sort" text="Trier par Points (VIP)" />
                              <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="btn-secondary" text="Actualiser" />
                           </children>
                        </HBox>
                        <TableView fx:id="tableClients" styleClass="data-table" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colNom" prefWidth="110.0" text="Nom" />
                            <TableColumn fx:id="colPrenom" prefWidth="110.0" text="Prénom" />
                            <TableColumn fx:id="colEmail" prefWidth="130.0" text="Email" />
                            <TableColumn fx:id="colPhone" prefWidth="100.0" text="Téléphone" />
                            <TableColumn fx:id="colNationality" prefWidth="100.0" text="Nationalité" />
                            <TableColumn fx:id="colBirthDate" prefWidth="100.0" text="Naissance" />
                            <TableColumn fx:id="colPoints" prefWidth="60.0" text="Points" />
                            <TableColumn fx:id="colNiveau" prefWidth="80.0" text="Niveau" />
                            <TableColumn fx:id="colStatut" prefWidth="80.0" text="Statut" />
                            <TableColumn fx:id="colActions" prefWidth="280.0" text="Actions (Edit / Suppr / Bloq)" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- Admin Management View -->
                  <VBox fx:id="adminManagementView" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <Label styleClass="page-title" text="Profils Administrateurs" />
                        <TableView fx:id="tableAdmins" styleClass="data-table" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colAdminNom" prefWidth="120.0" text="Nom" />
                            <TableColumn fx:id="colAdminPrenom" prefWidth="120.0" text="Prénom" />
                            <TableColumn fx:id="colAdminEmail" prefWidth="200.0" text="Email" />
                            <TableColumn fx:id="colAdminPhone" prefWidth="150.0" text="Téléphone" />
                            <TableColumn fx:id="colAdminNationality" prefWidth="150.0" text="Nationalité" />
                            <TableColumn fx:id="colAdminBirthDate" prefWidth="150.0" text="Date Naissance" />
                          </columns>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                     </padding>
                  </VBox>

                  <!-- Statistics View -->
                  <VBox fx:id="statisticsView" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <Label styleClass="page-title" text="Analyses et Statistiques" />
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                           <content>
                              <HBox spacing="20.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Répartition par Niveau de Fidélité" />
                                          <PieChart fx:id="loyaltyPieChart" prefHeight="350.0" />
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Répartition par Nationalité" />
                                          <PieChart fx:id="nationalityPieChart" prefHeight="350.0" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </content>
                        </ScrollPane>
                     </children>
                     <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                     </padding>
                  </VBox>


                  <!-- Placeholder: Reservations View -->
                  <VBox fx:id="reservationsView" alignment="CENTER" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <Label styleClass="page-title" text="Gestion Réservation Billets" />
                        <Label styleClass="field-label" text="Cette section est en construction..." />
                     </children>
                  </VBox>

                  <!-- Accommodations & Reservations Integrated View -->
                  <VBox fx:id="accommodationsView" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label styleClass="page-title" text="Gestion Hébergements &amp; Logements" />
                              <Region HBox.hgrow="ALWAYS" />
                              <HBox spacing="10.0" styleClass="sub-nav-bar">
                                 <children>
                                    <Button fx:id="btnNavHebergement" mnemonicParsing="false" onAction="#showHebergementsContent" styleClass="btn-sub-nav" text="🏨 Hébergements" />
                                    <Button fx:id="btnNavReservation" mnemonicParsing="false" onAction="#showReservationsContent" styleClass="btn-sub-nav" text="📋 Réservations" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        
                        <Separator styleClass="content-separator" />
                        
                        <StackPane fx:id="accommodationsContent" VBox.vgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                     </padding>
                  </VBox>

                  <!-- Placeholder: Activities View -->
                  <VBox fx:id="activitiesView" alignment="CENTER" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <Label styleClass="page-title" text="Gestion d'Activité" />
                        <Label styleClass="field-label" text="Cette section est en construction..." />
                     </children>
                  </VBox>

                  <!-- Placeholder: Reviews View -->
                  <VBox fx:id="reviewsView" alignment="CENTER" spacing="20.0" styleClass="content-pane" visible="false">
                     <children>
                        <Label styleClass="page-title" text="Gestion Avis" />
                        <Label styleClass="field-label" text="Cette section est en construction..." />
                     </children>
                  </VBox>

               </children>
            </StackPane>
         </content>
    </ScrollPane>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
